__pycache__/
data/crawl.log
crawler/probe_result.json
crawler/.hibrain-profile/
crawler/.hibrain-ok
crawler/.hibrain-cookies.json
crawler/.env
tools/.env

# 로컬 전용 — 타 플랫폼(스페이스클라우드) 미러·리드 데이터.
# 프로토타입 참고용이며 공개 배포(GitHub Pages)에 절대 올리지 않는다.
# 실서비스 시 미러링 금지 — 민간 연습실은 호스트 직접 등록 원칙.
local/
crawler/.geocode-cache.json

# 헬스체크 로컬 상태 — 이 PC에서만 의미 있는 baseline·로그 (공개 저장소에 불필요)
data/health.log
data/health_history.json
data/run_daily.log

# 수요 지도는 내부 분석 문서 — data/ 는 Pages로 그대로 공개되므로 올리지 않는다.
# (원본인 data/archive.json 은 자산이라 커밋한다: Actions 백업 크롤도 이걸 읽어 병합해야 한다)
data/demand_map.md
data/inst_gap.md
# 방문 통계는 로컬 전용 — 공개 저장소(Pages)에 사이트 분석 데이터를 올리지 않는다
data/traffic.json

# 메일 발송 도구는 로컬 전용 (커밋 금지 약속)
tools/
# 크롤러 주소 캐시
crawler/.addr_found.json
crawler/.addr_ok.json

# 텔레그램 토큰이 저장소 안으로 새지 않도록 (번들 notify.py의 로컬 폴백 후보)
crawler/config.json

# GA4 서비스 계정 키 — 자격증명은 절대 커밋 금지 (traffic.py가 .env 경유로 읽음)
crawler/ga4-sa.json
# 구글 클라우드 서비스 계정 키(Indexing API 등) — 폴더째 제외
crawler/.secrets/
# 구글 Indexing API 통보 기록 (로컬 상태)
data/gindex_state.json

# wrangler 로컬 캐시 (계정 정보·빌드 산출물) — 저장소에 들어갈 이유가 없다
feedback/.wrangler/
